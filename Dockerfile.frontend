FROM --platform=$BUILDPLATFORM demonstrationorg/dhi-node:24-alpine3.23-sfw-dev@sha256:8ed1a1c6b79c37d0f566983edd2e14eba81fa2b89d5f99605b63ccdcef4840de AS build
COPY . /app
WORKDIR /app
RUN yarn install
RUN yarn workspace app build

FROM demonstrationorg/dhi-nginx:1.29-alpine3.23-dev_backstage@sha256:62eef3ad10acd1a421eaad3d1e0bdd8e692887416a1b925a2cb8ea407875e97e
ARG UID=nginx
USER root
COPY --from=build --chown=nginx:nginx /app/packages/app/dist /usr/share/nginx/html
RUN chown -R $UID:$UID /usr/share/nginx/html/
RUN chmod -R g+w /usr/share/nginx/html/
COPY container-config/default.conf.template /etc/nginx/templates/default.conf.template
COPY container-config/inject-config.sh /docker-entrypoint.d/40-inject-config.sh
USER $UID
ENV PORT=8080
