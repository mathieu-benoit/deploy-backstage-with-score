FROM --platform=$BUILDPLATFORM demonstrationorg/dhi-node:24-alpine3.23-sfw-dev@sha256:145b5a358524b76902183ec2e1a4338179c11b07f69aa0ee08bc0dd7e0f0e172 AS build
COPY . /app
WORKDIR /app
RUN yarn install
RUN yarn workspace app build

FROM demonstrationorg/dhi-nginx:1.29-alpine3.23-dev_backstage@sha256:d51df9fb46bab20e6052fe889621e5c36935210eb99d0bad53d4152541d453a2
ARG UID=nginx
USER root
COPY --from=build --chown=nginx:nginx /app/packages/app/dist /usr/share/nginx/html
RUN chown -R $UID:$UID /usr/share/nginx/html/
RUN chmod -R g+w /usr/share/nginx/html/
COPY container-config/default.conf.template /etc/nginx/templates/default.conf.template
COPY container-config/inject-config.sh /docker-entrypoint.d/40-inject-config.sh
USER $UID
ENV PORT=8080
