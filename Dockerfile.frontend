FROM --platform=$BUILDPLATFORM demonstrationorg/dhi-node:24-alpine3.23-sfw-dev@sha256:362e63aeba06714327bd076eee1efebe9cf4d9176e7faee4cac895ce582cb0f0 AS build
COPY . /app
WORKDIR /app
RUN yarn install
RUN yarn workspace app build

FROM demonstrationorg/dhi-nginx:1.29-alpine3.23-dev_backstage@sha256:2ff6db989378553276db2d5d8289304d56d6a66bee6043bd30189aaf2ae87245
ARG UID=nginx
USER root
COPY --from=build --chown=nginx:nginx /app/packages/app/dist /usr/share/nginx/html
RUN chown -R $UID:$UID /usr/share/nginx/html/
RUN chmod -R g+w /usr/share/nginx/html/
COPY container-config/default.conf.template /etc/nginx/templates/default.conf.template
COPY container-config/inject-config.sh /docker-entrypoint.d/40-inject-config.sh
USER $UID
ENV PORT=8080
