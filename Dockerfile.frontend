FROM --platform=$BUILDPLATFORM demonstrationorg/dhi-node:24-alpine3.23-sfw-dev@sha256:43ab9768f26888586b2fdcaef0ebad058a9da0e8f53c71a36e26708fa1f2dd53 AS build
COPY . /app
WORKDIR /app
RUN yarn install
RUN yarn workspace app build

FROM demonstrationorg/dhi-nginx:1.29-alpine3.23-dev_backstage@sha256:f3dd3355e3b5525c708c7c909300f0d06d07830faf4a2e36be63cf61f10c59fb
ARG UID=nginx
USER root
COPY --from=build --chown=nginx:nginx /app/packages/app/dist /usr/share/nginx/html
RUN chown -R $UID:$UID /usr/share/nginx/html/
RUN chmod -R g+w /usr/share/nginx/html/
COPY container-config/default.conf.template /etc/nginx/templates/default.conf.template
COPY container-config/inject-config.sh /docker-entrypoint.d/40-inject-config.sh
USER $UID
ENV PORT=8080
